{
  "_comment": "路由决策表。规则从上往下匹配，第一条命中即生效（所以高优先级的风险规则放前面）。when 里的条件全部满足才算命中。score 类用 >= 档位下标（0 起），noul 类用概率阈值。",
  "version": "1.0",
  "queues": [
    {
      "id": "bot",
      "name": "机器人自助",
      "desc": "标准问题直接自动回复",
      "sla": "即时"
    },
    {
      "id": "logistics",
      "name": "物流专线",
      "desc": "查件、丢件、破损、错发",
      "sla": "3 分钟"
    },
    {
      "id": "aftersale",
      "name": "售后组",
      "desc": "退换货、退款、维修、发票",
      "sla": "5 分钟"
    },
    {
      "id": "presale",
      "name": "售前组",
      "desc": "商品咨询、价格活动、下单协助",
      "sla": "5 分钟"
    },
    {
      "id": "payment",
      "name": "支付与账号",
      "desc": "支付失败、重复扣款、账号异常",
      "sla": "5 分钟"
    },
    {
      "id": "vip",
      "name": "高优先专线",
      "desc": "情绪高、紧急、VIP，资深客服接",
      "sla": "60 秒"
    },
    {
      "id": "complaint",
      "name": "客诉专席",
      "desc": "投诉升级、监管媒体法律相关",
      "sla": "30 秒，同步主管"
    },
    {
      "id": "riskctrl",
      "name": "风控核查",
      "desc": "疑似异常索赔，先核查再回应",
      "sla": "转后台工单"
    }
  ],
  "rules": [
    {
      "id": "R1",
      "name": "监管/媒体/法律信号 → 客诉专席",
      "when": [
        {
          "q": "user_risk",
          "in": [
            "监管投诉",
            "媒体曝光",
            "法律诉讼"
          ]
        }
      ],
      "then": {
        "queue": "complaint",
        "human": true,
        "priority": "P0",
        "reason": "出现外部升级信号，必须人工且需主管同步，机器人不得再自动回复"
      }
    },
    {
      "id": "R2",
      "name": "人身攻击或暴怒 → 客诉专席",
      "when": [
        {
          "any": [
            {
              "q": "user_risk",
              "in": [
                "人身攻击"
              ]
            },
            {
              "q": "emotion",
              "gte": 4
            }
          ]
        }
      ],
      "then": {
        "queue": "complaint",
        "human": true,
        "priority": "P0",
        "reason": "情绪已失控或出现攻击性表达，转客诉专席并启动安抚话术"
      }
    },
    {
      "id": "R3",
      "name": "疑似薅羊毛 → 风控核查",
      "when": [
        {
          "q": "user_risk",
          "in": [
            "疑似薅羊毛"
          ]
        }
      ],
      "then": {
        "queue": "riskctrl",
        "human": true,
        "priority": "P2",
        "reason": "命中异常索赔特征，先转风控核查历史订单，不要当场承诺赔付"
      }
    },
    {
      "id": "R6",
      "name": "投诉意图 → 客诉专席",
      "when": [
        {
          "q": "intent",
          "in": [
            "投诉举报"
          ]
        }
      ],
      "then": {
        "queue": "complaint",
        "human": true,
        "priority": "P1",
        "reason": "用户明确要投诉，直接进客诉专席"
      }
    },
    {
      "id": "R4",
      "name": "高情绪 + 高紧急 → 高优先专线",
      "when": [
        {
          "q": "emotion",
          "gte": 2
        },
        {
          "q": "urgency",
          "gte": 2
        }
      ],
      "then": {
        "queue": "vip",
        "human": true,
        "priority": "P1",
        "reason": "用户明显不满且有时间压力，交给资深客服，60 秒内接起"
      }
    },
    {
      "id": "R5",
      "name": "模型判定该转人工 → 按意图进对应组",
      "when": [
        {
          "q": "escalate",
          "gte": 0.6
        }
      ],
      "then": {
        "queue": "byIntent",
        "human": true,
        "priority": "P2",
        "reason": "模型判断机器人已无法闭环，按业务意图转对应技能组"
      }
    },
    {
      "id": "R7",
      "name": "物流异常 → 物流专线",
      "when": [
        {
          "q": "intent",
          "in": [
            "物流异常"
          ]
        }
      ],
      "then": {
        "queue": "logistics",
        "human": true,
        "priority": "P2",
        "reason": "丢件破损错发需要人工查底单"
      }
    },
    {
      "id": "R8",
      "name": "其余按意图自助",
      "when": [],
      "then": {
        "queue": "byIntent",
        "human": false,
        "priority": "P3",
        "reason": "标准问题，机器人先答，答不了再升级"
      }
    }
  ],
  "intentQueue": {
    "物流查询": "bot",
    "物流异常": "logistics",
    "退款退货": "aftersale",
    "换货补发": "aftersale",
    "商品咨询": "presale",
    "价格优惠": "presale",
    "订单修改": "aftersale",
    "支付问题": "payment",
    "发票开票": "aftersale",
    "售后维修": "aftersale",
    "账号问题": "payment",
    "投诉举报": "complaint",
    "活动规则": "presale",
    "闲聊其他": "bot"
  },
  "_interceptComment": "客服危险话术拦截：命中且概率达到 minProb 就拦下不让发出，并给改写建议。",
  "intercept": {
    "minProb": 0.5,
    "blockLevels": {
      "绝对化承诺": "warn",
      "时效硬承诺": "warn",
      "推诿甩锅": "warn",
      "诋毁他人": "warn",
      "越权赔付": "block",
      "泄露隐私": "block",
      "情绪失控": "block",
      "私下交易": "block",
      "违规宣称": "block"
    },
    "rewrite": {
      "绝对化承诺": "把「一定/保证/百分百」换成「我这边会尽快为您跟进，预计……」，给范围不给绝对值。",
      "越权赔付": "不要直接报赔付金额。改成「您的情况我已记录，会按售后政策为您申请，审核结果 X 小时内回复您」。",
      "时效硬承诺": "改成「正常情况下大约 X，我先帮您标记加急，有结果第一时间同步」，明确这是预计而非承诺。",
      "泄露隐私": "立刻删除他人信息。只对当前用户核对其本人订单尾号，不要复述完整手机号和地址。",
      "情绪失控": "先停一句。改成「非常理解您现在的心情，这件事确实影响到您了，我来帮您处理」。",
      "推诿甩锅": "不要说不归我管。改成「这部分我来帮您对接 XX 同事，您不用再重复说明，我把记录带过去」。",
      "私下交易": "严禁引导站外。改成「所有售后都在平台内完成，这样您的权益才有保障」。",
      "违规宣称": "删除功效性表述。只描述商品客观参数和官方说明。",
      "诋毁他人": "不评价竞品和内部同事。只说自己能为用户做什么。"
    }
  }
}
