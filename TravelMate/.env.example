# ── LLM 配置（不填则使用 Mock 模式）──
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── 高德地图 REST API（本地 route/nearby/geocode/district 工具用）──
# AMAP_API_KEY=你的高德Key

# ── 多 Agent：外部 MCP Server 接入 ──
# 通用格式：MCP_<NAME>_MODE=http|stdio，其余按模式配置
# 连接失败会自动降级到本地工具，不影响使用

# 高德官方 MCP（Streamable HTTP）
# MCP_AMAP_MODE=http
# MCP_AMAP_URL=https://mcp.amap.com/mcp?key=你的高德Key

# 12306 火车票 MCP（stdio，需 Node.js；首次运行 npx 会自动下载包）
# MCP_12306_MODE=stdio
# MCP_12306_COMMAND=npx -y 12306-mcp
# MCP_12306_INIT_TIMEOUT=120
